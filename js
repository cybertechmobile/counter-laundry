const DB='LaundryWorkManager',stores=['employees','items','orders','rules','settings','queue'];let page='dashboard';const $=s=>document.querySelector(s);const uid=()=>crypto.randomUUID();const money=n=>'Rp '+Number(n||0).toLocaleString('id-ID');
function open(){return new Promise((a,b)=>{let r=indexedDB.open(DB,1);r.onupgradeneeded=()=>stores.forEach(s=>r.result.objectStoreNames.contains(s)||r.result.createObjectStore(s,{keyPath:'id'}));r.onsuccess=()=>a(r.result);r.onerror=()=>b(r.error)})}async function all(s){let d=await open();return new Promise(a=>{let r=d.transaction(s).objectStore(s).getAll();r.onsuccess=()=>a(r.result)})}async function one(s,id){return (await all(s)).find(x=>x.id===id)}async function put(s,x){let d=await open();return new Promise(a=>{let r=d.transaction(s,'readwrite').objectStore(s).put(x);r.onsuccess=a})}async function del(s,id){let d=await open();return new Promise(a=>{let r=d.transaction(s,'readwrite').objectStore(s).delete(id);r.onsuccess=a})}function toast(t){let x=$('#toast');x.textContent=t;x.classList.add('show');setTimeout(()=>x.classList.remove('show'),2200)}async function set(k,v){put('settings',{id:k,value:v})}async function setting(k,d=''){return (await one('settings',k))?.value??d}function go(p){page=p;render();if(innerWidth<900)$('.sidebar').classList.remove('open')}
